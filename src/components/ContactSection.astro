---
import type { CollectionEntry } from 'astro:content';
import SocialLinks from './SocialLinks.astro';

interface Props {
  home: CollectionEntry<'i18n'>['data']['home'];
}
const { home } = Astro.props;
const year = new Date().getFullYear();
const cs = home.contact_section;
---
<footer id="contact" class="footer" tabindex="-1" aria-labelledby="contact-title" aria-describedby="contact-desc">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <h2 class="section-title" id="contact-title" data-i18n="home.contact_section.title">{cs.title}</h2>
        <p id="contact-desc" data-i18n="home.contact_section.desc">{cs.desc}</p>
        <div class="social-links-footer">
          <SocialLinks home={home} />
        </div>
        <div style="margin-top: 3rem;">
          <a href="https://www.buymeacoffee.com/albertolicea00" target="_blank" class="bmc-link" aria-describedby="site-a11y-help">
            <img src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png" alt="Buy Me a Coffee" style="height: 60px !important; width: 217px !important; border-radius: 12px; transition: transform 0.2s ease;" />
          </a>
        </div>
      </div>
      <div class="contact-form-container glass-panel">
        <form id="contact-form" class="contact-form" aria-describedby="contact-form-help site-a11y-help">
          <div style="display:none" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-group">
            <label for="name" class="form-label" data-i18n="home.contact_section.labels.name">{cs.labels.name}</label>
            <input type="text" id="name" name="name" placeholder={cs.placeholders.name} required data-i18n-placeholder="home.contact_section.placeholders.name" autocomplete="name" />
          </div>
          <div class="form-group">
            <label for="email" class="form-label" data-i18n="home.contact_section.labels.email">{cs.labels.email}</label>
            <input type="email" id="email" name="email" placeholder={cs.placeholders.email} data-i18n-placeholder="home.contact_section.placeholders.email" autocomplete="email" />
          </div>
          <div class="form-group">
            <label for="phone" class="form-label" data-i18n="home.contact_section.labels.phone">{cs.labels.phone}</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder={cs.placeholders.phone}
              data-i18n-placeholder="home.contact_section.placeholders.phone"
              autocomplete="tel"
              pattern="^\+[\d\s\-\(\)]{7,20}$"
              title="Please include your country code starting with +"
            />
          </div>
          <div class="form-group">
            <label for="message" class="form-label" data-i18n="home.contact_section.labels.message">{cs.labels.message}</label>
            <textarea id="message" name="message" placeholder={cs.placeholders.message} rows="5" required data-i18n-placeholder="home.contact_section.placeholders.message"></textarea>
          </div>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAADbXNHnJ90i7PDY3" data-theme="dark" style="margin-bottom: 1rem;"></div>
          <div id="contact-form-status" role="status" aria-live="polite" style="display:none" data-success-msg={cs.success_msg} data-error-msg={cs.error_msg}></div>
          <button
            type="submit"
            id="contact-submit-btn"
            class="cta-btn"
            data-i18n="home.contact_section.submit_btn"
            data-i18n-tooltip="home.contact_section.submit_btn_tooltip"
            data-tooltip={cs.submit_btn_tooltip}
          >{cs.submit_btn}</button>
        </form>
      </div>
    </div>
    <p class="copyright" style="margin-top: 4rem">
      <span class="copyright-line">© <span id="year">{year}</span> Alberto Licea.</span>
      <span class="copyright-line" data-i18n="home.footer.rights">{home.footer.rights}</span>
    </p>
  </div>
</footer>
