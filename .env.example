# ==============================================================================
# Telegram Contact Form Configuration
# ==============================================================================
# Note: Rename this file to .env and fill in your values for local testing.
# For production, add these variables to your Vercel or Netlify project settings.

# 1. TELEGRAM_BOT_TOKEN
# Get this from @BotFather on Telegram by sending the /newbot command.
# It looks something like: "1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# 2. TELEGRAM_CHAT_ID
# The numeric ID of the chat where the bot will send messages.
# You can get your ID by starting a chat with @userinfobot on Telegram.
# It usually looks like a long string of numbers, e.g., "123456789"
TELEGRAM_CHAT_ID="your_numeric_chat_id_here"
